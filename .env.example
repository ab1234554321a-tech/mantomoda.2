# ===============================================
# MANTO MODA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or production
# ===============================================

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security Secrets (Never commit actual secret values to Git)
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
SESSION_SECRET=your_session_secret_key_here

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/manto_moda_db?schema=public"

# ---------------------------------------------------------------------------
# Payment Gateway (BL-006 / ADR-008)
# ---------------------------------------------------------------------------
# Which PSP adapter to use: "zarinpal" (default for production) or "mock" (offline/dev).
# Production REFUSES to start with an unset or unconfigured provider so a payment
# can never be silently faked.
PAYMENT_PROVIDER=zarinpal

# Merchant ID (36-character UUID) issued by Zarinpal after your store is approved.
# Obtain it at https://www.zarinpal.com -> panel -> درگاه پرداخت
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Keep true while integrating: payments go to the sandbox and no real money moves.
ZARINPAL_SANDBOX=true

# Public base URL the PSP redirects the customer back to. Must be HTTPS and
# reachable from the internet (not localhost) in production.
# Example: https://mantomoda.ir
PAYMENT_CALLBACK_BASE_URL=

# Optional: request timeout for PSP calls in milliseconds.
PAYMENT_HTTP_TIMEOUT_MS=8000

# Explicit opt-in required to run the mock payment/SMS providers in production
# (demo or staging environments only — NEVER on the live store).
ALLOW_MOCK_PROVIDERS=false

# ---------------------------------------------------------------------------
# SMS / OTP Provider (BL-007 / ADR-009)
# ---------------------------------------------------------------------------
# Which SMS panel to use: "kavenegar" (default for production) or "mock" (offline/dev).
SMS_PROVIDER=kavenegar

# API key from the Kavehnegar panel: https://panel.kavenegar.com -> تنظیمات -> API Key
KAVENEGAR_API_KEY=your_kavehnegar_api_key_here
# The shared/line number that sends OTP messages (e.g. 10008888, 2000...).
KAVENEGAR_SENDER=10008888
# Name of the pre-approved verification pattern (پترن) that contains the %token%
# placeholder the one-time code is injected into. Must match the panel exactly.
KAVENEGAR_OTP_TEMPLATE=manto-verify

# Optional: request timeout for SMS calls in milliseconds.
SMS_HTTP_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# OTP Policy (BL-007) — sensible defaults, tune to taste
# ---------------------------------------------------------------------------
# How long a one-time code stays valid.
OTP_TTL_SECONDS=120
# Failed attempts before the code is destroyed.
OTP_MAX_ATTEMPTS=5
# Minimum seconds between two code requests for the same mobile number.
OTP_RESEND_COOLDOWN_SECONDS=60
# Maximum codes that may be sent to one number per hour (anti SMS-pumping abuse).
OTP_MAX_SENDS_PER_HOUR=5

# Embedding / Frame Policy (optional)
# By default the app refuses to be embedded in iframes (frame-ancestors 'self').
# Widen ONLY for trusted staging or admin panels. Never use "*" in production.
# Example: CSP_FRAME_ANCESTORS=https://staging.mantomoda.ir,https://admin.mantomoda.ir
CSP_FRAME_ANCESTORS=
